          "rawSql": "SELECT\n    $__timeInterval(ts) AS time,\n    system_id,\n    max(multiIf(severity='critical', 2, severity='warning', 1, 0)) AS status\nFROM bigdata.alerts_log\nWHERE $__timeFilter(ts) AND resolved = 0\nGROUP BY time, system_id\nORDER BY time",
