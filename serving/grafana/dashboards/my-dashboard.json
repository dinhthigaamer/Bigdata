          "pluginVersion": "4.24.0",
          "queryType": "timeseries",
          "rawSql": "SELECT\n    $__timeInterval(window_start) AS time,\n    station_id,\n    sum(bikes_out) AS bikes_out\nFROM bigdata.station_flow_rt FINAL\nWHERE $__timeFilter(window_start)\n  AND station_id IN (\n      SELECT station_id\n      FROM bigdata.station_flow_rt\n      WHERE $__timeFilter(window_start)\n      GROUP BY station_id\n      ORDER BY sum(bikes_out) DESC\n      LIMIT 20\n  )\nGROUP BY time, station_id\nORDER BY time",
