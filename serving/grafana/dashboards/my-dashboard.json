          "rawSql": "SELECT\n    station_id,\n    sum(bikes_in)  AS total_in,\n    sum(bikes_out) AS total_out,\n    sum(net_flow)  AS total_net\nFROM bigdata.station_flow_rt FINAL\nWHERE $__timeFilter(window_start)\nGROUP BY station_id\nORDER BY abs(total_net) DESC\nLIMIT 10",
