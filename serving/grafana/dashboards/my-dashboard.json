          "pluginVersion": "4.24.0",
          "queryType": "table",
          "rawSql": "SELECT\n    l.system_id AS system_id,\n    l.station_id AS station_id,\n    d.station_name AS name,\n    d.station_lat AS lat,\n    d.station_lon AS lon,\n    l.bikes AS bikes,\n    l.docks AS docks,\n    d.station_capacity AS capacity,\n    if(d.station_capacity > 0, l.bikes / d.station_capacity, 0) AS fill_ratio,\n    l.last_event_ts AS event_ts\nFROM\n(\n    SELECT\n        system_id,\n        station_id,\n        argMax(num_bikes_available, event_ts) AS bikes,\n        argMax(num_docks_available, event_ts) AS docks,\n        max(event_ts) AS last_event_ts\n    FROM bigdata.station_latest\n    WHERE system_id IN (${system_id:singlequote})\n    GROUP BY system_id, station_id\n) AS l\nINNER JOIN\n(\n    SELECT\n        system_id,\n        station_id,\n        argMax(name, updated_at) AS station_name,\n        argMax(lat, updated_at) AS station_lat,\n        argMax(lon, updated_at) AS station_lon,\n        argMax(capacity, updated_at) AS station_capacity\n    FROM bigdata.dim_station\n    GROUP BY system_id, station_id\n) AS d USING (system_id, station_id)",
